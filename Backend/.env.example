# ─────────────────────────────────────────────────────────
#  FindMeds Backend — Environment Variables
#  Copy this file → .env and fill in the real values.
#  NEVER commit .env to GitHub.
# ─────────────────────────────────────────────────────────

# Server
PORT=5001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ── MongoDB Atlas ─────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers
# Replace <username>, <password>, <cluster> with your real values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/findmeds?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────
# Any long random string — use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────
# Get from Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Twilio (SMS) ──────────────────────────────────────────
# Get from twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── NodeMailer (Email via Gmail SMTP) ────────────────────
# Use a Gmail account + App Password (not your real password)
# Google Account → Security → 2FA on → App Passwords → generate one
EMAIL_USER=yourapp@gmail.com
EMAIL_APP_PASSWORD=Email_password_here

# ── Darpan API ────────────────────────────────────────────
# Register at niti.gov.in/darpan to get an API key
DARPAN_API_KEY=your_darpan_api_key
